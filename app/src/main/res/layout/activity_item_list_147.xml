<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/coordinatorItemList147"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_147">

    <LinearLayout
        android:id="@+id/linearItemListRoot147"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Header Bar with Professional Gradient -->
        <LinearLayout
            android:id="@+id/topBar147"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header_147"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingTop="20dp"
            android:paddingBottom="24dp">

            <ImageButton
                android:id="@+id/btnBackFromList147"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_circle_translucent_147"
                android:contentDescription="Kembali"
                android:padding="8dp"
                android:src="@drawable/ic_arrow_back_24"
                app:tint="@color/white" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvListHeaderTitle147"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Daftar Inventaris"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvListHeaderSubtitle147"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="NIM: 102042330147 • Kelola &amp; pantau stok"
                    android:textColor="#E0E7FF"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Search Bar Container (Overlapping cleanly) -->
        <LinearLayout
            android:id="@+id/searchSection147"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-14dp"
            android:orientation="vertical"
            android:paddingHorizontal="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_search_bar_147"
                android:elevation="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="Search Icon"
                    android:src="@drawable/ic_search_24"
                    app:tint="@color/text_secondary_147" />

                <EditText
                    android:id="@+id/etSearch147"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:background="@null"
                    android:hint="Cari nama barang atau kategori..."
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:textColor="@color/text_primary_147"
                    android:textColorHint="@color/text_tertiary_147"
                    android:textSize="14sp" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvItemCountSummary147"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="4dp"
                android:text="Menampilkan 0 barang"
                android:textColor="@color/text_secondary_147"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Empty State Container -->
        <LinearLayout
            android:id="@+id/layoutEmptyState147"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:background="@drawable/bg_badge_blue_147"
                android:contentDescription="Empty Icon"
                android:padding="20dp"
                android:src="@drawable/ic_box_24"
                app:tint="@color/secondary_147" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Belum Ada Data Barang"
                android:textColor="@color/text_primary_147"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Tekan tombol tambah (+) di sudut kanan bawah untuk mendaftarkan barang baru ke inventaris."
                android:textAlignment="center"
                android:textColor="@color/text_secondary_147"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvItems147"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingHorizontal="16dp"
            android:paddingTop="6dp"
            android:paddingBottom="84dp" />

    </LinearLayout>

    <!-- Floating Action Button to Add Item -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddItem147"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="24dp"
        android:backgroundTint="@color/secondary_147"
        android:contentDescription="Tambah Barang"
        android:src="@drawable/ic_add_24"
        app:elevation="4dp"
        app:tint="@color/white" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
